# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.

# Variables de entorno — Firebase Client SDK (NEXT_PUBLIC_ = expuestas al navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=
# En local y Preview: <proyecto>.firebaseapp.com (el que da Firebase).
# En PRODUCCIÓN (Vercel → Production): el dominio de la app, p. ej. nutricion-app-theta.vercel.app,
# para que el login por redirect funcione en el móvil. Requiere agregar
# https://<dominio>/__/auth/handler a las URIs de redirección autorizadas del cliente OAuth
# en Google Cloud Console y un redeploy (ver README, "Si falla el login en el móvil").
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Variables de entorno — Firebase Admin SDK (solo servidor, NO usar NEXT_PUBLIC_)
# Se usa en /api/analyze-meal para verificar la sesión y llevar el contador diario de IA.
# Opción A: pega el JSON completo de la Service Account Key, en UNA línea (si defines A y B, gana A)
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Opción B: campos individuales (alternativa si no quieres pegar el JSON completo)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# IA — Gemini API (para análisis de fotos de comida)
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.5-flash-lite). Cámbialo si Google lo renombra.
GEMINI_MODEL=
# Opcional: máximo de análisis con IA por usuario y día (por defecto 40)
AI_DAILY_LIMIT_PER_USER=

# Solo desarrollo/pruebas: "true" conecta la app a los emuladores de Firebase.
# NO la definas en Vercel. Tampoco FIREBASE_AUTH_EMULATOR_HOST ni FIRESTORE_EMULATOR_HOST
# (activarían el modo sin credenciales del Admin SDK).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
