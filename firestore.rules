rules_version = '2';

// ============================================================
// Reglas de Firestore — NutriTrack
// ============================================================
// Principio: cada usuario solo lee y escribe dentro de users/{su uid}.
// Todo lo que no está listado explícitamente queda DENEGADO.
// Además se valida la forma básica de los datos para que un cliente
// modificado no pueda guardar documentos gigantes o con tipos inválidos.
// (El Admin SDK del servidor no pasa por estas reglas.)

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -------------------------------------------------------

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isNum(v, min, max) {
      return (v is int || v is float) && v >= min && v <= max;
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optNum(field, min, max) {
      return !(field in incoming()) || isNum(incoming()[field], min, max);
    }

    function optStr(field, maxLen) {
      return !(field in incoming()) || isStr(incoming()[field], maxLen);
    }

    function ownsDoc(userId) {
      return incoming().uid == userId;
    }

    // ----- Perfil: users/{userId} ---------------------------------------------

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUser(userId);

      function validUser(userId) {
        return incoming().keys().hasOnly([
            'uid', 'email', 'displayName', 'photoURL',
            'age', 'sex', 'heightCm', 'weightKg', 'goal',
            'isActive', 'activities',
            'dailyCaloriesTarget', 'dailyProteinGTarget', 'dailyCarbsGTarget', 'dailyFatGTarget',
            'dailyWaterLTarget', 'bmr', 'tdee', 'activityMultiplier', 'goalsCustomized',
            'onboardingCompleted', 'createdAt', 'updatedAt'
          ])
          && ownsDoc(userId)
          && optStr('email', 320)
          && optStr('displayName', 200)
          && optStr('photoURL', 2048)
          && optNum('age', 0, 120)
          && optNum('heightCm', 0, 260)
          && optNum('weightKg', 0, 400)
          && (!('sex' in incoming()) || incoming().sex in ['male', 'female'])
          && (!('goal' in incoming()) || incoming().goal in ['lose_fat', 'maintain', 'gain_muscle'])
          && (!('activities' in incoming()) || (incoming().activities is list && incoming().activities.size() <= 4))
          && optNum('dailyCaloriesTarget', 0, 10000)
          && optNum('dailyProteinGTarget', 0, 1000)
          && optNum('dailyCarbsGTarget', 0, 1500)
          && optNum('dailyFatGTarget', 0, 1000)
          && optNum('dailyWaterLTarget', 0, 10);
      }

      // ----- Comidas: users/{userId}/meals/{mealId} -----------------------------
      match /meals/{mealId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMeal(userId);

        function validMeal(userId) {
          return incoming().keys().hasOnly([
              'uid', 'date', 'type', 'source', 'title', 'aiConfidence', 'foods',
              'totalCalories', 'totalProteinG', 'totalCarbsG', 'totalFatG', 'createdAt', 'updatedAt'
            ])
            && ownsDoc(userId)
            && isDateKey(incoming().date)
            && incoming().type in ['breakfast', 'lunch', 'dinner', 'snack']
            && incoming().source in ['ai_photo', 'ai_text', 'manual', 'text_search', 'recipe']
            && incoming().foods is list && incoming().foods.size() <= 50
            && isNum(incoming().totalCalories, 0, 50000)
            && isNum(incoming().totalProteinG, 0, 5000)
            && isNum(incoming().totalCarbsG, 0, 5000)
            && isNum(incoming().totalFatG, 0, 5000)
            && optStr('title', 120);
        }
      }

      // ----- Peso: users/{userId}/weightLogs/{YYYY-MM-DD} ------------------------
      match /weightLogs/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly(['uid', 'date', 'weightKg', 'waistCm', 'hipCm', 'chestCm', 'armCm', 'notes', 'createdAt'])
          && ownsDoc(userId)
          && incoming().date == date && isDateKey(date)
          && isNum(incoming().weightKg, 20, 400)
          && optNum('waistCm', 0, 300) && optNum('hipCm', 0, 300)
          && optNum('chestCm', 0, 300) && optNum('armCm', 0, 300)
          && optStr('notes', 500);
      }

      // ----- Agua: users/{userId}/water/{YYYY-MM-DD} ----------------------------
      match /water/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly(['uid', 'date', 'totalMl', 'entries', 'updatedAt'])
          && ownsDoc(userId)
          && incoming().date == date && isDateKey(date)
          && isNum(incoming().totalMl, 0, 30000)
          && incoming().entries is list && incoming().entries.size() <= 100;
      }

      // ----- Recetas: users/{userId}/recipes/{recipeId} --------------------------
      match /recipes/{recipeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly([
              'uid', 'name', 'description', 'servings', 'ingredients', 'tags', 'suggestedId',
              'totalCalories', 'totalProteinG', 'totalCarbsG', 'totalFatG',
              'caloriesPerServing', 'proteinGPerServing', 'carbsGPerServing', 'fatGPerServing',
              'createdAt', 'updatedAt'
            ])
          && ownsDoc(userId)
          && isStr(incoming().name, 120) && incoming().name.size() > 0
          && optStr('description', 1000)
          && isNum(incoming().servings, 0.25, 50)
          && incoming().ingredients is list && incoming().ingredients.size() <= 100
          && (!('tags' in incoming()) || (incoming().tags is list && incoming().tags.size() <= 8))
          && isNum(incoming().caloriesPerServing, 0, 50000);
      }

      // ----- Plan: users/{userId}/mealPlans/{YYYY-MM-DD} --------------------------
      match /mealPlans/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly(['uid', 'date', 'items', 'updatedAt'])
          && ownsDoc(userId)
          && incoming().date == date && isDateKey(date)
          && incoming().items is list && incoming().items.size() <= 40;
      }

      // ----- Lista de compras: users/{userId}/shoppingLists/{lunes} --------------
      match /shoppingLists/{weekStart} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly(['uid', 'weekStart', 'checked', 'extras', 'updatedAt'])
          && ownsDoc(userId)
          && incoming().weekStart == weekStart && isDateKey(weekStart)
          && incoming().checked is list && incoming().checked.size() <= 300
          && incoming().extras is list && incoming().extras.size() <= 100;
      }

      // ----- Uso diario de IA: lo escribe solo el servidor (Admin SDK) -----------
      match /aiUsage/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Cualquier otra subcolección: denegada (no hay comodín)
    }
  }
}
